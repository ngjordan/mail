[Desktop Entry]
Type=Application
Version=1.4
Name=Mail
GenericName=Mail Client
Comment=Read and write mail, and manage your calendar, contacts, tasks and notes
Exec=iridium-mail
TryExec=iridium-mail
Icon=ph.mail
Terminal=false
Categories=Office;Email;Calendar;ContactManagement;
MimeType=message/rfc822;application/mbox;text/calendar;text/vcard;application/vnd.ms-outlook;x-scheme-handler/mailto;
Keywords=mail;email;e-mail;inbox;imap;smtp;calendar;contacts;tasks;notes;
StartupNotify=true
StartupWMClass=ph.mail
